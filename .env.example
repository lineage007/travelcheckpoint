# TravelCheckpoint environment variables. Every provider is optional.
# Copy to .env.local for local dev; set in Vercel dashboard for production.

# ── Core ─────────────────────────────────────────────
# Public base URL — used by the price-alert runner to call /api/search.
# Set to your Vercel deployment URL (e.g. https://travelcheckpoint.vercel.app).
# If omitted, the alert runner will fall back to the automatic VERCEL_URL env var.
NEXT_PUBLIC_BASE_URL=https://travelcheckpoint.vercel.app

# ── Security ─────────────────────────────────────────
# Optional pre-shared secret for POST /api/alerts. Note: the in-app alert form does not
# send this header yet, so setting it blocks alerts created from the UI.
# Generate with: openssl rand -hex 32
# Must be sent as header: X-TC-Secret: <value>
TC_SECRET=

# ── Telegram notifications ───────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DROP_THRESHOLD_PCT=10
# Optional JSON list of alerts to seed the in-memory store on cold start
ALERTS_JSON=

# ── Flight data ──────────────────────────────────────
SEATS_AERO_API_KEY=
SERPAPI_KEY=
CASH_FLIGHTS_API_URL=
# Hidden-city results need a proxy (Skiplagged is behind Cloudflare)
SKIPLAGGED_PROXY_URL=

# ── Hotel data ───────────────────────────────────────
LITEAPI_KEY=

# ── AI (chat assistant) ──────────────────────────────
GROQ_API_KEY=
GOOGLE_AI_API_KEY=

# ── Booking integrations ─────────────────────────────
DUFFEL_API_KEY=

# ── Affiliate IDs (optional; links work without them) ──
NEXT_PUBLIC_BOOKING_AID=
NEXT_PUBLIC_EXPEDIA_CAMREF=
NEXT_PUBLIC_HOTELSCOM_CAMREF=
NEXT_PUBLIC_AGODA_CID=
NEXT_PUBLIC_SKYSCANNER_ASSOCIATEID=
NEXT_PUBLIC_KIWI_AFFILID=
NEXT_PUBLIC_GYG_PARTNER_ID=
NEXT_PUBLIC_VIATOR_PID=
